# Copy to .env and fill in real values locally. Never commit .env.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Neon Postgres, project region AWS Asia Pacific (Singapore) ap-southeast-1,
# colocated with Vercel functions in sin1 (vercel.json).
# Always end both URLs with: ?sslmode=verify-full&channel_binding=require
#   DATABASE_URL: the POOLED connection string (host contains "-pooler"), used by the app.
#   DIRECT_URL:   the DIRECT connection string (no "-pooler"), used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Google Gen AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Session signing / hashing secret (long random string, e.g. `openssl rand -base64 48`)
SESSION_SECRET=
