# Copy to .env and fill in real values locally. Never commit .env.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Neon Postgres, project region AWS Asia Pacific (Singapore) ap-southeast-1,
# colocated with Vercel functions in sin1 (vercel.json).
# Always end both URLs with: ?sslmode=verify-full&channel_binding=require
#   DATABASE_URL: the POOLED connection string (host contains "-pooler"), used by the app.
#   DIRECT_URL:   the DIRECT connection string (no "-pooler"), used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Demo login (D55, D71). Off unless exactly "true". When on, login accepts only
# the demo code 123456 and shows it on screen. This is a controlled demo
# mechanism, NOT production SMS authentication. Never enable with real users.
AUTH_DEMO_OTP=false

# Google Gen AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=


# Integration tests only (D49): a separate Neon TEST BRANCH, direct connection,
# with ?sslmode=verify-full&channel_binding=require. Prepare it once: pnpm test:db:init
TEST_DATABASE_URL=
# Comma-separated hosts that tests must never touch (e.g. the old US database).
PROTECTED_DATABASE_HOSTS=

# Cart quote signing key (D75): base64 of at least 32 random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-only. Without it, cart previews and order placement fail closed.
QUOTE_SIGNING_KEY=
